# ==========================================================================
#  Revathy Dentistree — production server config (Hostinger / LiteSpeed / Apache)
# ==========================================================================

DirectoryIndex index.html
AddDefaultCharset UTF-8
Options -Indexes

# --- Force HTTPS + non-www (canonical: https://revathydentistree.com/) ---------
<IfModule mod_rewrite.c>
    RewriteEngine On
    # redirect any http:// or www. request to the canonical https non-www host
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://revathydentistree.com%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Friendly error page -------------------------------------------------------
ErrorDocument 404 /404.html

# --- Gzip / text compression ---------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
        application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# --- Browser caching (faster repeat visits = better Core Web Vitals) -----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                        "access plus 1 month"
    ExpiresByType text/html               "access plus 1 hour"
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 6 months"
    ExpiresByType image/png               "access plus 6 months"
    ExpiresByType image/svg+xml           "access plus 6 months"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType image/webp              "access plus 6 months"
    ExpiresByType video/mp4               "access plus 6 months"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# --- Basic security headers ----------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
